# Copy to deploy/.env on the VPS (setup.sh does this automatically).
# Never commit the real .env.
NODE_ENV=production
API_PORT=3000
WEBHOOK_PORT=9000

# Shared with GitHub webhook settings. Generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# Branch that triggers a redeploy on push
WEBHOOK_BRANCH=claude/deploy-vercel-5TXlD

# Rotate this before going live. openssl rand -hex 48
JWT_SECRET=change-me
