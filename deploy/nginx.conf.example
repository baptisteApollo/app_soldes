# Rendered by deploy/setup.sh (placeholders are substituted).
# After Certbot runs, it will edit this file in place to add the TLS block.

server {
    listen 80;
    listen [::]:80;
    __SERVER_NAME__

    client_max_body_size 20M;

    # Expo web bundle (static)
    root __WEB_ROOT__;
    index index.html;

    # GitHub webhook -> local listener
    location = /__hooks/github {
        proxy_pass         http://127.0.0.1:__WEBHOOK_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Hub-Signature-256 $http_x_hub_signature_256;
        proxy_set_header   X-GitHub-Event      $http_x_github_event;
    }

    # API
    location /api/ {
        proxy_pass         http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # SPA fallback for the Expo web bundle
    location / {
        try_files $uri $uri/ /index.html;
    }
}
